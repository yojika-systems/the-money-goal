---
import Base from './Base.astro';
import { getCollection } from 'astro:content';
import { createHash } from 'node:crypto';
import { dmyLong, iso } from '../lib/format.js';
import { postHref, MARKETS, isPublished } from '../lib/publication.js';
import { getOffer, offerExitUrl } from '../lib/offers.js';
import { EDUCATION_ONLY } from '../lib/disclosures.js';
interface Props { post: any; headings: { depth: number; slug: string; text: string }[] }
const { post, headings } = Astro.props;
const d = post.data;
const canonical = new URL(postHref(post), 'https://themoneygoal.com').href;
const digest = createHash('sha256').update(post.body.trim()).digest('hex');
const family = await getCollection('blog', e => isPublished(e.data) && e.data.translationKey === d.translationKey && e.data.market === d.market);
const activeOffers = d.offerIds.map(id => getOffer(id, d.market)).filter(Boolean);
const stale = new Date(d.reviewDue) < new Date();
const toc = headings.filter(h => h.depth === 2);
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': d.contentType === 'news' ? 'NewsArticle' : 'BlogPosting', headline: d.title, description: d.description,
    datePublished: iso(d.pubDate), dateModified: iso(d.updatedDate ?? d.pubDate), inLanguage: d.lang,
    author: { '@type': 'Organization', name: 'The MoneyGoal', url: 'https://themoneygoal.com/about' },
    publisher: { '@type': 'Organization', name: 'The MoneyGoal', url: 'https://themoneygoal.com' }, mainEntityOfPage: canonical },
  { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Guides', item: 'https://themoneygoal.com/guides' }, { '@type': 'ListItem', position: 2, name: d.title, item: canonical } ] }
] };
---
<Base title={`${d.title} | The MoneyGoal`} description={d.description} canonical={canonical} lang={d.lang} ogType="article" jsonLd={jsonLd}>
  <Fragment slot="head">
    <meta name="content-digest" content={digest} />
    {family.map(entry => <link rel="alternate" hreflang={entry.data.lang === 'en' ? (d.market === 'global' ? 'en' : `en-${d.market}`) : entry.data.lang} href={new URL(postHref(entry), 'https://themoneygoal.com').href} />)}
  </Fragment>
  <div class="border-b border-rule bg-tint px-5 py-3 text-sm md:px-10 lg:px-20"><a href="/guides">Guides</a> / <a href={`/topics/${d.topic}`}>{d.category}</a> / {MARKETS[d.market]}</div>
  <div class="mx-auto grid max-w-[1280px] items-start gap-10 px-5 py-12 md:px-10 lg:grid-cols-[210px_minmax(0,760px)] lg:px-20">
    <nav aria-label="On this page" class="hidden text-sm lg:block"><div class="mb-4 border-b border-rule pb-3 uppercase tracking-wider text-muted">On this page</div><ul class="space-y-3">{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
    <article>
      <p class="mb-4 text-xs uppercase tracking-wider text-green">{MARKETS[d.market]} · {d.contentType}</p>
      <h1 class="mb-5 font-serif text-4xl font-bold leading-tight md:text-5xl">{d.title}</h1>
      <p class="mb-7 font-serif text-xl leading-relaxed text-ink3">{d.description}</p>
      <div class="mb-6 flex flex-wrap gap-x-5 gap-y-2 border-y border-rule py-4 text-sm text-muted">
        <span>Published by <a href="/about">The MoneyGoal</a></span><time datetime={iso(d.pubDate)}>{dmyLong(d.pubDate)}</time>
        {d.updatedDate && <span>Updated <time datetime={iso(d.updatedDate)}>{dmyLong(d.updatedDate)}</time></span>}
      </div>
      <p class="mb-6 border-l-2 border-caveat bg-caveat-bg p-4 text-sm leading-relaxed">{EDUCATION_ONLY} {d.aiAssisted && <span>Produced with AI assistance and automated checks. <a href="/methodology">How this works and its limits</a>.</span>}</p>
      {stale && <p class="mb-6 border border-rule p-4 text-sm">This page is due for a source review. Check current provider and regulator documents before acting. <a href="/corrections">Report an issue</a>.</p>}
      <div class="prose prose-lg max-w-none prose-headings:font-serif prose-p:leading-relaxed prose-a:text-green"><slot /></div>
      {activeOffers.length > 0 && !stale && <section class="mt-10 border border-rule bg-tint p-6"><h2 class="mb-3 font-serif text-2xl">Related provider information</h2><p class="mb-4 text-sm">Paid links: we may receive a commission if you complete the provider’s qualifying action. This does not establish that the product suits you. <a href="/affiliate-disclosure">Our commercial policy</a>.</p>{activeOffers.map(o => <p class="mb-3"><a href={offerExitUrl(o, d.market, post.slug, 'article-footer')} rel="noopener sponsored" target="_blank" data-offer={o.id} data-placement="article-footer" data-market={d.market}>{o.approvedWording}</a><span class="block text-sm text-muted">Compensation: {o.compensation}. Applications happen on the provider’s site.</span></p>)}</section>}
      <section class="mt-10 border-t border-rule pt-6"><h2 class="mb-4 font-serif text-2xl">Sources and calculation methods</h2><ol class="list-decimal space-y-3 pl-5 text-sm leading-relaxed">{d.sources.map(s => <li id={`source-${s.id}`}><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> · {s.publisher}. Checked {dmyLong(s.accessed)}.{s.published && <span> Published {dmyLong(s.published)}.</span>}{s.effective && <span> Effective {dmyLong(s.effective)}.</span>}</li>)}</ol>
        {d.calculationRefs.length > 0 && <p class="mt-4 text-sm">Examples are generated from checked code: {d.calculationRefs.map(id => <a href={`/methodology#${id}`} class="mr-3">{id.replaceAll('-', ' ')}</a>)}.</p>}
      </section>
      <div class="mt-8 flex flex-wrap gap-5 border-t border-rule pt-5 text-sm"><a href="/calculators">Try the calculators →</a><a href="/corrections">Report a correction →</a></div>
    </article>
  </div>
</Base>
