---
import Base from '../layouts/Base.astro';
import SipCalculator from '../components/widgets/SipCalculator.astro';

const title = 'Calculators that show their working';
const description =
  'An SIP calculator where the assumed return and the expense ratio are sliders, not hidden constants. Every assumption sits next to the answer, and nothing you type leaves your browser.';

const RELATED = [
  { title: 'What an expense ratio actually costs you', blurb: 'Why the fee slider moves the answer more than you expect.', href: '/mutual-funds' },
  { title: 'The number you are actually aiming for', blurb: 'The Rule of 25, and a planner for the date it implies.', href: '/financial-freedom' },
  { title: 'A five-minute financial health check', blurb: 'Whether investing is even the right next step for you.', href: '/financial-health' },
];
---

<Base title={`${title} | The MoneyGoal`} description={description}>
  <section class="px-5 pt-14 md:px-10 lg:px-20">
    <div class="mx-auto max-w-[1440px]">
      <h1 class="mb-4 font-serif text-[36px] font-bold leading-[1.14] tracking-tight md:text-[46px]">
        Calculators that show their working
      </h1>
      <p class="mb-9 max-w-[680px] text-[17px] leading-[1.7] text-ink3 md:text-[18px]">
        Every assumption sits next to the answer, and you can change all of them. Nothing you type is
        sent anywhere — this runs entirely in your browser.
      </p>
      <nav class="flex flex-wrap gap-0 border-b border-rule" aria-label="Calculators">
        <span class="-mb-px border-b-2 border-green px-5 py-3.5 text-[15.5px] font-medium text-ink">SIP calculator</span>
        <a href="/financial-freedom" class="px-5 py-3.5 text-[15.5px] text-ink3 hover:text-ink">Financial freedom planner</a>
        <a href="/financial-health" class="px-5 py-3.5 text-[15.5px] text-ink3 hover:text-ink">Financial health check</a>
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-11 md:px-10 lg:px-20">
    <SipCalculator />
    <div class="mt-6 border-l-[3px] border-caveat bg-caveat-bg px-6 py-5">
      <p class="text-[14.5px] leading-[1.7] text-ink3">
        <strong class="text-ink">This is an illustration, not a forecast or personal advice.</strong>
        Nothing here predicts what any fund will do. Real returns vary year to year and can be
        negative. The MoneyGoal is not a SEBI-registered Investment Adviser or Research Analyst.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 pb-16 md:px-10 lg:px-20">
    <div class="border-t border-rule pt-8">
      <div class="mb-6 text-[12.5px] uppercase tracking-[0.09em] text-muted">
        Understand what you just changed
      </div>
      <div class="grid gap-px border border-rule bg-rule md:grid-cols-3">
        {
          RELATED.map((r) => (
            <a href={r.href} class="block bg-surface px-7 pb-8 pt-7">
              <div class="mb-2 font-serif text-[20px] font-semibold leading-[1.3] text-ink">{r.title}</div>
              <div class="text-[14.5px] leading-[1.65] text-ink3">{r.blurb}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
