---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/publication.js';
const posts = (await getCollection('blog', ({ data }) => isPublished(data) && data.lang === 'en')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Financial guides and explainers | The MoneyGoal" description="Explore financial guides with exact sources, transparent calculation assumptions, global basics and clearly labelled India and United States coverage.">
  <section class="mx-auto max-w-[1100px] px-5 py-14 md:px-10"><p class="mb-4 text-xs uppercase tracking-wider text-green">Learn, calculate, compare</p><h1 class="mb-5 font-serif text-4xl font-bold md:text-5xl">Financial guides and explainers</h1><p class="mb-6 max-w-[700px] text-lg leading-relaxed text-ink3">Understand the concept, change the assumptions, and check the sources. Country-specific rules are labelled on every article.</p><nav aria-label="Browse guides" class="flex flex-wrap gap-5 border-y border-rule py-4 text-sm"><a href="/topics">By topic</a><a href="/global">Global basics</a><a href="/in">India</a><a href="/us">United States</a><a href="/news">Economy &amp; policy</a></nav><PostList posts={posts} /></section>
</Base>
