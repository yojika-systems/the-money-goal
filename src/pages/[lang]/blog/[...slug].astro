---
/* Translated articles at /<lang>/blog/<slug>.
 *
 * Astro's post.slug for src/content/blog/hi/foo.md is "hi/foo", so the language
 * segment is stripped before it becomes the route param — the language is
 * already the first path segment. */
import Article from '../../../layouts/Article.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../../lib/publication.js';
import { DEFAULT_LANG , stripLangPrefix} from '../../../lib/languages.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => isPublished(data) && (data.lang !== DEFAULT_LANG || (data.market !== 'global' && !data.legacyUrl)));
  return posts.map((post) => ({
    params: { lang: post.data.lang === DEFAULT_LANG ? post.data.market.toLowerCase() : post.data.lang, slug: stripLangPrefix(post.slug) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
---

<Article post={post} headings={headings}><Content /></Article>
