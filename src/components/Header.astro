---
import { NAV } from '../lib/nav.js';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="border-b border-rule bg-paper">
  <div class="mx-auto flex h-[68px] max-w-[1440px] items-center justify-between gap-6 px-5 md:px-10 lg:px-20">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${'The MoneyGoal'} home`}>
      <Logo class="h-[26px] w-[26px]" />
      <span class="font-serif text-[19px] font-bold tracking-tight"
        >The Money<span class="text-green">Goal</span></span
      >
    </a>

    <nav class="hidden items-center gap-6 text-sm lg:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'py-1 transition-colors hover:text-ink',
              isCurrent(item.href)
                ? 'border-b-2 border-green font-medium text-ink'
                : 'text-ink3',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href="/guides"
        class="hidden bg-ink px-4 py-2.5 text-sm font-medium text-paper transition-opacity hover:opacity-90 sm:inline-block"
        >Read the basics</a
      >
      <details class="relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center"
          aria-label="Open menu"
        >
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 z-40 w-64 border border-rule bg-surface p-2 shadow-lg"
          aria-label="Primary"
        >
          {
            NAV.map((item) => (
              <a href={item.href} class="block px-3 py-3 text-[15px] text-ink3 hover:bg-tint hover:text-ink">
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
