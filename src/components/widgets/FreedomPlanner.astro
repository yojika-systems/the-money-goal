---
/* Replaces the invented projection on the old financial-freedom page.
 *
 * The figures describe ONE hypothetical household and are labelled as such.
 * Every assumption is rendered next to the output rather than 330 lines further
 * down the page, which is where the old disclosure sat.
 */
const BASE = {
  income: 65000,
  expense: 35000,
  sip: 15000,
  age: 31.2,
  annualReturn: 0.12,
  withdrawalMultiple: 25,
};
---

<div
  class="border border-rule bg-surface"
  id="freedom-planner"
  data-config={JSON.stringify(BASE)}
>
  <div class="border-b border-rule px-7 pb-4 pt-5">
    <h2 class="font-serif text-[21px] font-semibold">What redirecting spending does</h2>
    <p class="mt-1.5 text-[13.5px] text-muted">
      One hypothetical household earning &#8377;65,000 a month. Move the slider to send more of it
      into investing instead.
    </p>
  </div>

  <div class="px-7 py-6">
    <div class="mb-2 flex items-baseline justify-between">
      <label for="cut" class="text-sm text-ink3">Redirected from spending each month</label>
      <span class="num text-xl font-semibold" id="cut-badge">&#8377;5,000</span>
    </div>
    <input
      type="range"
      id="cut"
      min="0"
      max="15000"
      step="1000"
      value="5000"
      class="h-1 w-full cursor-pointer accent-[#0B5C3F]"
    />
    <div class="num mt-2 flex justify-between text-xs text-faint"><span>&#8377;0</span><span>&#8377;15,000</span></div>
  </div>

  <dl class="grid border-t border-rule sm:grid-cols-3">
    <div class="border-b border-rule px-7 py-5 sm:border-b-0 sm:border-r">
      <dt class="mb-2.5 text-xs uppercase tracking-[0.07em] text-muted">Monthly spending</dt>
      <dd class="num font-serif text-[26px] font-bold" id="out-expense">&#8377;30,000</dd>
    </div>
    <div class="border-b border-rule px-7 py-5 sm:border-b-0 sm:border-r">
      <dt class="mb-2.5 text-xs uppercase tracking-[0.07em] text-muted">Monthly investing</dt>
      <dd class="num font-serif text-[26px] font-bold" id="out-sip">&#8377;20,000</dd>
    </div>
    <div class="px-7 py-5">
      <dt class="mb-2.5 text-xs uppercase tracking-[0.07em] text-muted">Target corpus</dt>
      <dd class="num font-serif text-[26px] font-bold text-green" id="out-corpus">&#8377;90.0 L</dd>
    </div>
  </dl>

  <div class="border-t border-rule bg-tint2 px-7 py-6">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <span class="text-sm text-ink3">Reaches the target in</span>
      <span class="num font-serif text-[30px] font-bold" id="out-years">about 14.2 years</span>
    </div>
    <p class="mt-3 text-[15px] leading-[1.7] text-ink3" id="out-impact"></p>
    <p class="mt-4 border-t border-dashed border-[#D8D1C3] pt-3.5 text-[13.5px] leading-[1.68] text-ink3">
      <span class="font-semibold text-caveat">Illustration, not a forecast or personal advice.</span>
      Starting from zero, investing every month without interruption at an assumed 12% p.a. nominal
      return, targeting 25&times; annual expenses (the 4% withdrawal rule). Real returns vary year to
      year, can be negative, and arrive unevenly. Inflation and tax are not modelled.
    </p>
  </div>
</div>

<script>
  import { yearsToTarget, targetCorpus, inr, inrCompact } from '../../lib/finance.js';

  const root = document.getElementById('freedom-planner');
  if (root) {
    const cfg = JSON.parse(root.dataset.config || '{}');
    const slider = document.getElementById('cut');
    const el = (id) => document.getElementById(id);
    const baselineYears = yearsToTarget(
      cfg.sip,
      targetCorpus(cfg.expense * 12, cfg.withdrawalMultiple),
      cfg.annualReturn,
    );

    const render = (cut) => {
      const expense = cfg.expense - cut;
      const sip = cfg.sip + cut;
      const corpus = targetCorpus(expense * 12, cfg.withdrawalMultiple);
      const years = yearsToTarget(sip, corpus, cfg.annualReturn);

      el('cut-badge').textContent = inr(cut);
      el('out-expense').textContent = inr(expense);
      el('out-sip').textContent = inr(sip);
      el('out-corpus').textContent = inrCompact(corpus);
      el('out-years').textContent = `about ${years.toFixed(1)} years`;
      el('out-impact').textContent =
        cut === 0
          ? `This is the baseline: investing ${inr(cfg.sip)} a month toward a ${inrCompact(corpus)} target.`
          : `Redirecting ${inr(cut)} a month reaches the target about ${(baselineYears - years).toFixed(1)} years sooner, because it both raises the amount invested and lowers the target to ${inrCompact(corpus)}.`;
    };

    slider.addEventListener('input', (e) => render(Number(e.target.value)));
    // Render on load so the page can never show figures that disagree with the
    // slider's actual position — the old page shipped four mismatched numbers.
    render(Number(slider.value));
  }
</script>
