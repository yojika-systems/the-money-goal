<aside id="analytics-choices" aria-label="Optional analytics choices" class="fixed bottom-4 left-4 right-4 z-50 mx-auto max-w-[580px] border border-rule bg-paper p-5 shadow-lg" hidden>
  <h2 class="mb-2 font-serif text-xl font-semibold" tabindex="-1">Optional analytics</h2>
  <p class="mb-3 text-sm leading-relaxed text-ink3">Allow analytics to help us understand visits and useful tools? Your financial answers and calculator values stay in your browser. <a href="/privacy" class="underline">Privacy details</a>.</p>
  <p data-privacy-signal class="mb-3 text-sm text-ink3" hidden>Your browser’s privacy signal keeps optional analytics off.</p>
  <div class="grid grid-cols-2 gap-3">
    <button type="button" data-analytics-choice="granted" class="border border-ink px-3 py-3 text-sm font-semibold disabled:opacity-50">Allow analytics</button>
    <button type="button" data-analytics-choice="denied" class="border border-ink px-3 py-3 text-sm font-semibold">Reject analytics</button>
  </div>
</aside>
<script>
  import {createAnalyticsController,installAnalyticsController,readAnalyticsConsent,hasPrivacySignal} from '../lib/analytics.js';
  const panel=document.querySelector<HTMLElement>('#analytics-choices');
  let storage: Pick<Storage,'getItem'|'setItem'>;
  try{storage=window.localStorage;}catch{storage={getItem:()=>null,setItem:()=>{}};}
  const controller=createAnalyticsController({win:window,doc:document,nav:navigator,storage});installAnalyticsController(controller);controller.init();
  const signal=hasPrivacySignal(navigator);
  if(panel){
    panel.hidden=signal||readAnalyticsConsent(storage)!==null;
    const allow=panel.querySelector<HTMLButtonElement>('[data-analytics-choice="granted"]');if(allow)allow.disabled=signal;
    const note=panel.querySelector<HTMLElement>('[data-privacy-signal]');if(note)note.hidden=!signal;
    panel.querySelectorAll<HTMLButtonElement>('[data-analytics-choice]').forEach(button=>button.addEventListener('click',()=>{controller.choose(button.dataset.analyticsChoice);panel.hidden=true;}));
    document.querySelectorAll<HTMLButtonElement>('[data-open-analytics]').forEach(button=>button.addEventListener('click',()=>{panel.hidden=false;panel.querySelector<HTMLElement>('h2')?.focus();}));
  }
</script>
