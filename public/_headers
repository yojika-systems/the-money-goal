# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The CSP could not ship before the Astro rebuild: the four Stitch pages loaded
# the Tailwind Play CDN and hotlinked six images from lh3.googleusercontent.com,
# both of which a restrictive policy blocks outright. Both are gone.
#
# script-src keeps 'unsafe-inline' because Astro 4 inlines small component
# scripts as <script type="module"> and offers no nonce or hash pipeline. The
# widgets are bundled (no define:vars, no is:inline), so nothing is loaded from
# a third-party origin — 'self' covers everything that is external.
#
# style-src needs 'unsafe-inline' for the inline style attributes the widgets
# write (progress bars set style.width) and for Astro's inlined stylesheets.
#
# fonts.googleapis.com / fonts.gstatic.com carry Source Serif 4 and IBM Plex
# Sans. img-src stays 'self' data: — there are no third-party images at all now.
# connect-src 'self' because the site makes zero network calls at runtime; the
# calculators run entirely in the browser, which is a claim the pages make.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; upgrade-insecure-requests

# Content-hashed build assets are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
